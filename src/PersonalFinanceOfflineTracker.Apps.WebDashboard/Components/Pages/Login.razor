@using PersonalFinanceOfflineTracker.Apps.WebDashboard.Services
@inject AuthApiClient AuthApiClient
@inject AuthSession AuthSession
@inject NavigationManager NavigationManager

@page "/login"
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<h1>Login</h1>

@if (AuthSession.IsAuthenticated)
{
    <div class="alert alert-success">
        Signed in as <strong>@AuthSession.Email</strong>.
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="GoToTransactions">Transactions</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="GoToCategories">Categories</button>
        <button type="button" class="btn btn-danger" @onclick="Logout">Logout</button>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="form" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="form.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="form.Password" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">@(isSubmitting ? "Signing in..." : "Sign in")</button>
    </EditForm>

    <p class="mt-3 text-muted">Seed dev account: <code>owner@local.dev</code> / <code>P@ssword123!</code></p>
}

@code {
    private LoginFormModel form = new();
    private bool isSubmitting;
    private string errorMessage = string.Empty;

    private async Task HandleLoginAsync()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        var (isSuccess, message) = await AuthApiClient.LoginAsync(form.Email.Trim(), form.Password, CancellationToken.None);
        isSubmitting = false;

        if (!isSuccess)
        {
            errorMessage = message;
            return;
        }

        NavigationManager.NavigateTo("/");
    }

    private void Logout()
    {
        AuthApiClient.Logout();
    }

    private void GoToTransactions() => NavigationManager.NavigateTo("/transactions");

    private void GoToCategories() => NavigationManager.NavigateTo("/categories");

    private sealed class LoginFormModel
    {
        public string Email { get; set; } = "owner@local.dev";
        public string Password { get; set; } = "P@ssword123!";
    }
}
